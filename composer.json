{
    "name": "gabrieldevro/laravel-llms-txt",
    "description": "Serve /llms.txt and /llms-full.txt from your Laravel app so ChatGPT, Claude, Perplexity and other AI assistants understand your site. Build sections from config, routes or Eloquent models.",
    "keywords": ["laravel", "llms.txt", "llms-txt", "llms-full.txt", "ai", "seo", "geo", "generative-engine-optimization", "chatgpt", "claude", "perplexity", "markdown"],
    "license": "MIT",
    "authors": [
        { "name": "Gabriel Conolache", "email": "contact@gabrieldev.eu", "homepage": "https://gabrieldev.eu" }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": { "Gabrieldev\\LlmsTxt\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Gabrieldev\\LlmsTxt\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Gabrieldev\\LlmsTxt\\LlmsTxtServiceProvider"],
            "aliases": { "LlmsTxt": "Gabrieldev\\LlmsTxt\\Facades\\LlmsTxt" }
        }
    },
    "scripts": { "test": "phpunit" },
    "minimum-stability": "stable",
    "prefer-stable": true
}
